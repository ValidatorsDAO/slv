#jinja2: lstrip_blocks: True
{#
  slv.nft: the inbound firewall of one Solana node, rendered from its listen model
  (the output of the slv_listen_model filter). Which ports are open, and to whom, comes
  from the model alone.

  slv_fw_model  the listen model
  slv_fw_meta   generated_at and controller_ip, written to the header comment only, after
                slv_listen_model_meta has checked them (a timestamp and an address, no control
                character); anything else stops the render with invalid_meta
#}
{% macro ports(items) %}{% for p in items %}{{ p[0] if p[0] == p[1] else p[0] ~ '-' ~ p[1] }}{{ ', ' if not loop.last else '' }}{% endfor %}{% endmacro %}
{% macro braced(items) %}{ {{ ports(items) }} }{% endmacro %}
{% macro quoted(names) %}{% for n in names %}"{{ n }}"{{ ', ' if not loop.last else '' }}{% endfor %}{% endmacro %}
{% macro v6mask(bits) %}{% set g = namespace(items=[]) %}{% for i in range(bits // 16) %}{% set g.items = g.items + ['ffff'] %}{% endfor %}{% if bits % 16 %}{% set g.items = g.items + ['%x' | format(65536 - 2 ** (16 - bits % 16))] %}{% endif %}{{ g.items | join(':') }}{{ '' if g.items | length == 8 else '::' }}{% endmacro %}
{% set m = slv_fw_model %}
{% set meta = slv_fw_meta | slv_listen_model_meta %}
# /etc/slv/nftables/slv.nft  generated by slv  model=sha256:{{ m.model_sha256 }}  ssh_mode={{ m.ssh.mode }}  {{ meta.generated_at }}{{ '  controller=' ~ meta.controller_ip if meta.controller_ip else '' }}
# This file defines the whole table: loading it replaces an existing table of this name in one
# transaction, and the set elements are written inline.
table inet slv
delete table inet slv
table inet slv {
  # sol_udp holds the public UDP ports of the Solana client (the dynamic port range, a pinned
  # gossip port, the fixed ports of Frankendancer); pub_udp holds those of components
  # (WireGuard). xdp_udp holds the ones of sol_udp that a kernel-bypass net tile (AF_XDP or
  # mlx5) normally takes before netfilter sees them, so a packet that reaches the kernel on one
  # of them is counted by c_xdp_fallback instead of c_sol_udp (rule order): the tile did not
  # take that packet.
{% set port_sets = [
  ('sol_udp', m.udp.public),
  ('xdp_udp', m.udp.xdp),
  ('pub_udp', m.udp.pub),
  ('pub_tcp', m.tcp.public),
  ('ssh_ports', m.tcp.ssh),
  ('mgmt_tcp', m.tcp.mgmt),
  ('consumer_tcp', m.tcp.consumer),
  ('metrics_tcp', m.tcp.metrics),
] %}
{% for name, items in port_sets %}
  set {{ '%-12s' | format(name) }} { type inet_service; flags interval;{{ ' elements = { ' ~ ports(items) ~ ' }' if items else '' }} }
{% endfor %}
{% set addr_sets = [
  ('mgmt', m.sources.mgmt),
  ('lb', m.sources.lb),
  ('scrape', m.sources.scrape),
  ('deny', m.sources.deny),
] %}
{% for name, src in addr_sets %}
  set {{ '%-9s' | format(name ~ '_v4') }} { type ipv4_addr; flags interval;{{ ' elements = { ' ~ src.v4 | join(', ') ~ ' }' if src.v4 else '' }} }
  set {{ '%-9s' | format(name ~ '_v6') }} { type ipv6_addr; flags interval;{{ ' elements = { ' ~ src.v6 | join(', ') ~ ' }' if src.v6 else '' }} }
{% endfor %}
{% for a in m.udp.allowlist %}
{% set key = a.component | replace('-', '_') %}
{% if a.sources.v4 %}
  set {{ key }}_v4 { type ipv4_addr; flags interval; elements = { {{ a.sources.v4 | join(', ') }} } }
{% endif %}
{% if a.sources.v6 %}
  set {{ key }}_v6 { type ipv6_addr; flags interval; elements = { {{ a.sources.v6 | join(', ') }} } }
{% endif %}
{% endfor %}
{% if m.ssh.public %}
  set ssh_rl_v4 { type ipv4_addr; size 65535; flags dynamic,timeout; timeout 1m; }
  set ssh_rl_v6 { type ipv6_addr; size 65535; flags dynamic,timeout; timeout 1m; }
{% endif %}
{% set counters = ['c_sol_udp', 'c_mgmt', 'c_spoof', 'c_deny', 'c_xdp_fallback', 'c_icmp_err', 'c_invalid', 'c_icmp', 'c_consumer_lb', 'c_consumer_mgmt', 'c_metrics', 'c_tail'] + (['c_ssh_rl'] if m.ssh.public else []) + (['c_consumer_pub'] if m.consumer_public else []) %}
{% for c in counters %}
  counter {{ c }} { }
{% endfor %}

  # Only the Solana UDP packets to and from this host skip conntrack, so packets that this
  # host forwards (containers, VMs, tunnels) keep their conntrack entry and their NAT. The
  # exception is the reply to a masqueraded UDP flow whose host-side port is in sol_udp or
  # xdp_udp: it is addressed to this host, skips conntrack and is not translated back.
  chain pre_raw {
    type filter hook prerouting priority raw; policy accept;
    fib daddr type local meta nfproto ipv4 udp dport @sol_udp notrack
    fib daddr type local meta nfproto ipv4 udp dport @xdp_udp notrack
  }
  chain out_raw {
    type filter hook output priority raw; policy accept;
    meta nfproto ipv4 udp sport @sol_udp notrack
    meta nfproto ipv4 udp sport @xdp_udp notrack
  }

  # The ports that a management source, a trusted interface or the WireGuard tunnel may reach.
  # The chain is called before deny, so a deny entry does not cut them off from these ports.
  chain mgmt_ok {
    tcp dport @ssh_ports counter name "c_mgmt" accept
    tcp dport @mgmt_tcp accept
    tcp dport @consumer_tcp counter name "c_consumer_mgmt" accept
    tcp dport @metrics_tcp counter name "c_metrics" accept
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    iif != "lo" ip daddr 127.0.0.0/8 drop
    iif != "lo" ip6 daddr ::1 drop
    # a packet that arrives from outside with one of this host's own addresses as its source
    iif != "lo" meta pkttype host fib saddr type local counter name "c_spoof" drop
    ip saddr @mgmt_v4 jump mgmt_ok
    ip6 saddr @mgmt_v6 jump mgmt_ok
{% if m.wireguard.enabled %}
    iifname "{{ m.wireguard.iface }}" ip saddr {{ m.wireguard.subnet }} jump mgmt_ok
{% endif %}
{% for i in m.trusted_ifaces %}
    iifname "{{ i }}" jump mgmt_ok
{% endfor %}
    # before the conntrack rules, so that deny also cuts flows that are already open
    ip saddr @deny_v4 counter name "c_deny" drop
    ip6 saddr @deny_v6 counter name "c_deny" drop
    # Solana UDP is accepted by port, not by conntrack state: packets that XDP sends skip
    # conntrack, so the replies to them arrive as new
    meta nfproto ipv4 udp dport @xdp_udp counter name "c_xdp_fallback" accept
    meta nfproto ipv4 udp dport @sol_udp counter name "c_sol_udp" accept
    udp dport @pub_udp accept
    tcp dport @pub_tcp accept
    # ICMP errors for flows that conntrack never saw are invalid; they must still get in
    icmp type { destination-unreachable, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    ct state invalid counter name "c_invalid" drop
    ct state established,related accept
    # IPv6 neighbour discovery and multicast listener discovery are untracked, so they need their own rules
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } ip6 hoplimit 255 accept
{% if m.host.ra_ifaces %}
    iifname { {{ quoted(m.host.ra_ifaces) }} } icmpv6 type nd-router-advert ip6 saddr fe80::/10 ip6 hoplimit 255 accept
{% endif %}
    icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } ip6 saddr fe80::/10 accept
{% if m.host.dhcp6_ifaces %}
    iifname { {{ quoted(m.host.dhcp6_ifaces) }} } ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{% endif %}
{% if m.host.dhcp4_ifaces %}
    iifname { {{ quoted(m.host.dhcp4_ifaces) }} } meta nfproto ipv4 udp sport 67 udp dport 68 accept
{% endif %}
    icmp type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    icmpv6 type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    ip saddr @lb_v4 tcp dport @consumer_tcp counter name "c_consumer_lb" accept
    ip6 saddr @lb_v6 tcp dport @consumer_tcp counter name "c_consumer_lb" accept
    ip saddr @scrape_v4 tcp dport @metrics_tcp counter name "c_metrics" accept
    ip6 saddr @scrape_v6 tcp dport @metrics_tcp counter name "c_metrics" accept
{% if m.ssh.public %}
    # SSH is open to everybody, rate limited for each source (the management sources, the trusted
    # interfaces and the tunnel were accepted above)
    meta nfproto ipv4 tcp dport @ssh_ports ct state new add @ssh_rl_v4 { ip saddr limit rate over {{ m.ssh.rate.new_per_minute }}/minute burst {{ m.ssh.rate.burst }} packets } counter name "c_ssh_rl" drop
    meta nfproto ipv6 tcp dport @ssh_ports ct state new add @ssh_rl_v6 { ip6 saddr & {{ v6mask(m.ssh.rate.v6_prefix) }} limit rate over {{ m.ssh.rate.new_per_minute }}/minute burst {{ m.ssh.rate.burst }} packets } counter name "c_ssh_rl" drop
    tcp dport @ssh_ports ct state new accept
{% endif %}
{% if m.consumer_public %}
    tcp dport @consumer_tcp counter name "c_consumer_pub" accept
{% endif %}
{% for a in m.udp.allowlist %}
{% set key = a.component | replace('-', '_') %}
{% if a.sources.v4 %}
    ip saddr @{{ key }}_v4 udp dport {{ braced(a.ports) }} accept
{% endif %}
{% if a.sources.v6 %}
    ip6 saddr @{{ key }}_v6 udp dport {{ braced(a.ports) }} accept
{% endif %}
{% endfor %}
{% for c in m.components %}
{% for r in c.iface_rules %}
    iifname "{{ r.iifname }}" {{ r.proto }} dport {{ braced(r.ports) }} accept
{% endfor %}
{% endfor %}
{% if m.wireguard.enabled and m.tcp.wg_only %}
    iifname "{{ m.wireguard.iface }}" ip saddr {{ m.wireguard.subnet }} tcp dport {{ braced(m.tcp.wg_only) }} accept
{% endif %}
    counter name "c_tail"
  }
}
