# /etc/slv/nftables/slv.nft  generated by slv  model=sha256:9d611050ac8f4a88cf397ad2064a0212835049a0bd3ea0257d19a38516b3491e  ssh_mode=refuse  2026-01-01T00:00:00Z  controller=198.51.100.7
# This file defines the whole table: loading it replaces an existing table of this name in one
# transaction, and the set elements are written inline.
table inet slv
delete table inet slv
table inet slv {
  # sol_udp holds the public UDP ports of the Solana client (the dynamic port range, a pinned
  # gossip port, the fixed ports of Frankendancer); pub_udp holds those of components
  # (WireGuard). xdp_udp holds the ones of sol_udp that a kernel-bypass net tile (AF_XDP or
  # mlx5) normally takes before netfilter sees them, so a packet that reaches the kernel on one
  # of them is counted by c_xdp_fallback instead of c_sol_udp (rule order): the tile did not
  # take that packet.
  set sol_udp      { type inet_service; flags interval; elements = { 8001, 8003, 8900-8924, 9001, 9007 } }
  set xdp_udp      { type inet_service; flags interval; elements = { 8003, 9001, 9007 } }
  set pub_udp      { type inet_service; flags interval; }
  set pub_tcp      { type inet_service; flags interval; }
  set ssh_ports    { type inet_service; flags interval; elements = { 22 } }
  set mgmt_tcp     { type inet_service; flags interval; elements = { 6001 } }
  set consumer_tcp { type inet_service; flags interval; elements = { 8899-8900 } }
  set metrics_tcp  { type inet_service; flags interval; elements = { 7999, 9100 } }
  set mgmt_v4   { type ipv4_addr; flags interval; elements = { 198.51.100.7/32, 203.0.113.0/28 } }
  set mgmt_v6   { type ipv6_addr; flags interval; elements = { 2001:db8:10::/64 } }
  set lb_v4     { type ipv4_addr; flags interval; elements = { 192.0.2.10/32 } }
  set lb_v6     { type ipv6_addr; flags interval; }
  set scrape_v4 { type ipv4_addr; flags interval; elements = { 192.0.2.20/32 } }
  set scrape_v6 { type ipv6_addr; flags interval; }
  set deny_v4   { type ipv4_addr; flags interval; }
  set deny_v6   { type ipv6_addr; flags interval; }
  counter c_sol_udp { }
  counter c_mgmt { }
  counter c_spoof { }
  counter c_deny { }
  counter c_xdp_fallback { }
  counter c_icmp_err { }
  counter c_invalid { }
  counter c_icmp { }
  counter c_consumer_lb { }
  counter c_consumer_mgmt { }
  counter c_metrics { }
  counter c_tail { }

  # Only the Solana IPv4 UDP packets to and from this host skip conntrack, so packets that this
  # host forwards (containers, VMs, tunnels) keep their conntrack entry and their NAT. An IPv4
  # UDP packet to a sol_udp or xdp_udp port that is addressed to this host gets no NAT at all:
  # neither the return of a masqueraded flow nor a DNAT of such a port is translated. The skip
  # opens nothing; the input chain decides what comes in.
  chain pre_raw {
    type filter hook prerouting priority raw; policy accept;
    fib daddr type local meta nfproto ipv4 udp dport @sol_udp notrack
    fib daddr type local meta nfproto ipv4 udp dport @xdp_udp notrack
  }
  chain out_raw {
    type filter hook output priority raw; policy accept;
    meta nfproto ipv4 udp sport @sol_udp notrack
    meta nfproto ipv4 udp sport @xdp_udp notrack
  }

  # The ports that a management source, a trusted interface or the WireGuard tunnel may reach.
  # The chain is called before deny, so a deny entry does not cut them off from these ports.
  chain mgmt_ok {
    tcp dport @ssh_ports counter name "c_mgmt" accept
    tcp dport @mgmt_tcp accept
    tcp dport @consumer_tcp counter name "c_consumer_mgmt" accept
    tcp dport @metrics_tcp counter name "c_metrics" accept
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    iif != "lo" ip daddr 127.0.0.0/8 drop
    iif != "lo" ip6 daddr ::1 drop
    # a packet that arrives from outside with one of this host's own addresses as its source
    iif != "lo" meta pkttype host fib saddr type local counter name "c_spoof" drop
    ip saddr @mgmt_v4 jump mgmt_ok
    ip6 saddr @mgmt_v6 jump mgmt_ok
    # before the conntrack rules, so that deny also cuts flows that are already open
    ip saddr @deny_v4 counter name "c_deny" drop
    ip6 saddr @deny_v6 counter name "c_deny" drop
    # IPv4 Solana UDP is accepted by port, not by conntrack state: packets that XDP sends skip
    # conntrack, so the replies to them arrive as new
    meta nfproto ipv4 udp dport @xdp_udp counter name "c_xdp_fallback" accept
    meta nfproto ipv4 udp dport @sol_udp counter name "c_sol_udp" accept
    udp dport @pub_udp accept
    tcp dport @pub_tcp accept
    # ICMP errors for flows that conntrack never saw are invalid; they must still get in
    icmp type { destination-unreachable, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    ct state invalid counter name "c_invalid" drop
    ct state established,related accept
    # IPv6 neighbour discovery and multicast listener discovery are untracked, so they need their own rules
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } ip6 hoplimit 255 accept
    iifname { "eno1" } icmpv6 type nd-router-advert ip6 saddr fe80::/10 ip6 hoplimit 255 accept
    icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } ip6 saddr fe80::/10 accept
    iifname { "eno1" } ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
    iifname { "eno1" } meta nfproto ipv4 udp sport 67 udp dport 68 accept
    icmp type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    icmpv6 type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    ip saddr @lb_v4 tcp dport @consumer_tcp counter name "c_consumer_lb" accept
    ip6 saddr @lb_v6 tcp dport @consumer_tcp counter name "c_consumer_lb" accept
    ip saddr @scrape_v4 tcp dport @metrics_tcp counter name "c_metrics" accept
    ip6 saddr @scrape_v6 tcp dport @metrics_tcp counter name "c_metrics" accept
    counter name "c_tail"
  }
}
