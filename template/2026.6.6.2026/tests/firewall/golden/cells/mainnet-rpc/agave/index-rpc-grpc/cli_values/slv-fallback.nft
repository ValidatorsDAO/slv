# /etc/slv/nftables/slv-fallback.nft  generated by slv  model=sha256:5ad2b6a2fbf3466d397d19624efd21881d9da10e29869e6ede3263af37d12e78  ssh_mode=refuse  2026-01-01T00:00:00Z  controller=198.51.100.7
# Same table name as slv.nft, so that loading either one replaces the other.
table inet slv
delete table inet slv
table inet slv {
  set sol_udp   { type inet_service; flags interval; elements = { 8000-8029 } }
  set xdp_udp   { type inet_service; flags interval; }
  set ssh_ports { type inet_service; flags interval; elements = { 22 } }
  set mgmt_v4   { type ipv4_addr; flags interval; elements = { 198.51.100.7/32, 203.0.113.0/28 } }
  set mgmt_v6   { type ipv6_addr; flags interval; elements = { 2001:db8:10::/64 } }
  counter c_sol_udp { }
  counter c_mgmt { }
  counter c_spoof { }
  counter c_xdp_fallback { }
  counter c_icmp_err { }
  counter c_invalid { }
  counter c_icmp { }
  counter c_tail { }

  chain pre_raw {
    type filter hook prerouting priority raw; policy accept;
    fib daddr type local meta nfproto ipv4 udp dport @sol_udp notrack
    fib daddr type local meta nfproto ipv4 udp dport @xdp_udp notrack
  }
  chain out_raw {
    type filter hook output priority raw; policy accept;
    meta nfproto ipv4 udp sport @sol_udp notrack
    meta nfproto ipv4 udp sport @xdp_udp notrack
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
    iif != "lo" ip daddr 127.0.0.0/8 drop
    iif != "lo" ip6 daddr ::1 drop
    iif != "lo" meta pkttype host fib saddr type local counter name "c_spoof" drop
    # SSH from the management sources, and from the tunnel and the trusted interfaces when there are any
    ip saddr @mgmt_v4 tcp dport @ssh_ports counter name "c_mgmt" accept
    ip6 saddr @mgmt_v6 tcp dport @ssh_ports counter name "c_mgmt" accept
    meta nfproto ipv4 udp dport @xdp_udp counter name "c_xdp_fallback" accept
    meta nfproto ipv4 udp dport @sol_udp counter name "c_sol_udp" accept
    icmp type { destination-unreachable, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } limit rate 100/second burst 200 packets counter name "c_icmp_err" accept
    ct state invalid counter name "c_invalid" drop
    ct state established,related accept
    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } ip6 hoplimit 255 accept
    iifname { "eno1" } icmpv6 type nd-router-advert ip6 saddr fe80::/10 ip6 hoplimit 255 accept
    icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } ip6 saddr fe80::/10 accept
    iifname { "eno1" } ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
    iifname { "eno1" } meta nfproto ipv4 udp sport 67 udp dport 68 accept
    icmp type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    icmpv6 type echo-request limit rate 10/second burst 20 packets counter name "c_icmp" accept
    counter name "c_tail"
  }
}
